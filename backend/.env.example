# Speech-Book backend 环境变量示例（复制为 .env 后修改）
# 所有变量以 SB_ 为前缀
#
# 三种形态，同一份代码切换：
#   1) 纯本机 POC：下面保持默认（SQLite + 本地文件 + 内存进度）
#   2) 本机连容器中间件：见根目录 .env.example，数据库/对象存储地址填服务名
#   3) docker 完整栈：由 docker-compose.yml 的 environment 注入，一般不用本地 .env

SB_APP_NAME="AI Audiobook Studio"
SB_DEBUG=true

# ------------------------------------------------------------ 数据库
# POC：本地 SQLite 文件；完整栈用 postgresql+asyncpg://speech:pw@db:5432/speech_book
SB_DATABASE_URL="sqlite+aiosqlite:///./speech_book.db"

# ------------------------------------------------------------ JWT
SB_JWT_SECRET="dev-secret-change-me-in-prod"
SB_JWT_ALGORITHM="HS256"
SB_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------ CORS（生产收紧为前端域名）
SB_CORS_ORIGINS='["*"]'

# ------------------------------------------------------------ 存储
# local：写 SB_STORAGE_DIR 目录，经 /files/{path} 由后端反代出
# minio：写对象存储桶，下载走临时签名直链
SB_STORAGE_BACKEND="local"
SB_STORAGE_DIR="./data"
SB_MINIO_ENDPOINT="minio:9000"
SB_MINIO_ACCESS_KEY="minioadmin"
SB_MINIO_SECRET_KEY="minioadmin"
SB_MINIO_SECURE=false
SB_MINIO_BUCKET="speech-book"
SB_MINIO_PUBLIC_BASE_URL=""      # 填 "http://host:9000/speech-book" 则前端直连对象存储

# ------------------------------------------------------------ Redis
# memory：进程内进度广播（POC）
# redis ：广播到所有副本，SSE 订阅可横向扩容（完整栈）
SB_PROGRESS_BACKEND="memory"
SB_REDIS_URL="redis://redis:6379/0"
SB_TASK_QUEUE_BACKEND="memory"   # 接独立 worker 容器时改 redis
