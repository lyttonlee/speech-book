# Speech-Book backend 环境变量示例（复制为 .env 后修改）
# 所有变量以 SB_ 为前缀

SB_APP_NAME="AI Audiobook Studio"
SB_DEBUG=true

# 数据库：POC 使用本地 SQLite；生产替换为 PostgreSQL+pgvector 连接串
SB_DATABASE_URL="sqlite+aiosqlite:///./speech_book.db"

# JWT
SB_JWT_SECRET="dev-secret-change-me-in-prod"
SB_JWT_ALGORITHM="HS256"
SB_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS（生产收紧为前端域名）
SB_CORS_ORIGINS='["*"]'

# 本地文件存储目录（POC 替代 MinIO）
SB_STORAGE_DIR="./data"

# POC 模式：true 表示任务在进程内异步执行、进度走内存 Hub（替代 Redis Stream + Worker）
SB_POC_MODE=true
