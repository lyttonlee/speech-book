# ============================================================
# 语音书 (speech-book) · .gitignore
# 原则：只提交源码与文档；本地数据 / 依赖 / 构建产物 / 密钥 /
#       IDE 配置 / 系统文件一律不进入版本库
# 注意：gitignore 不支持「行内注释」，# 注释必须独占一行
# ============================================================

# ---------- Python（backend/，uv 管理） ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/

# ---------- 数据库 / 运行时数据（POC 本地存储，绝不提交） ----------
*.db
*.sqlite
*.sqlite3
backend/data/
data/
*.wav
*.mp3

# ---------- Node / 前端（web/，pnpm 管理） ----------
node_modules/
dist/
.pnpm-store/
.vite/
*.tsbuildinfo
.eslintcache
coverage/

# ---------- 环境变量 / 密钥（含敏感信息，永不提交） ----------
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key

# ---------- 日志 ----------
*.log
logs/
npm-debug.log*
pnpm-debug.log*

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- WorkBuddy 工作区数据（会话/记忆，本地专用） ----------
.workbuddy/

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------- 临时文件 ----------
*.tmp
*.bak
*.orig
.tmp/
