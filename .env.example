# ============================================================
# AI Audiobook Studio · 部署配置文件
#
# 用法：复制为项目根目录的 .env（文件名必须完全一致，compose 会自动读）
#   cp .env.example .env
#
# 只填你改过的：没出现在这里的变量会走 docker-compose.yml 里的默认值。
# 安全项（口令/密钥）一律改掉再上线。
# ============================================================

# ------------------------------------------------------------ 基础
# 容器/项目名前缀，docker ps 里一眼认出是本项目的容器
COMPOSE_PROJECT_NAME=speech-book

# ------------------------------------------------------------ PostgreSQL（含 pgvector / pgvecto.rs）
# 想换 Rust 版向量扩展：SB_POSTGRES_IMAGE=pgvector/pgvectors:latest
SB_POSTGRES_IMAGE=pgvector/pgvector:pg16
SB_DB_USER=speech
SB_DB_PASSWORD=speech_secret
SB_DB_NAME=speech_book
SB_DB_PORT=5432

# ------------------------------------------------------------ Redis
SB_REDIS_IMAGE=redis:7-alpine
SB_REDIS_PORT=6379

# ------------------------------------------------------------ 对象存储（S3 兼容）
# MinIO 官方项目已归档（dl.min.io 返回 410、多数镜像源 403），
# 默认改用 versity/versitygw：S3 协议兼容，后端用标准 minio-py 客户端，无需改代码。
# 若你的网络能拉到 MinIO 镜像，改成 SB_MINIO_IMAGE=minio/minio:latest 即可。
SB_MINIO_IMAGE=versity/versitygw:latest
SB_MINIO_USER=minio
SB_MINIO_PASSWORD=minio_secret
SB_MINIO_BUCKET=speech-book
SB_MINIO_PORT=9000
SB_MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------ 端口映射
SB_BACKEND_PORT=8000
SB_WEB_PORT=80

# ------------------------------------------------------------ 应用（后端环境变量，前缀固定 SB_）
SB_JWT_SECRET=change-me-before-deploy
# 生产收紧为前端域名，注意是 JSON 数组字符串
SB_CORS_ORIGINS='["http://localhost","http://127.0.0.1"]'
SB_DEBUG=false
