; ---- 本机 pnpm 配置（POC 环境适配）----
; 依赖提升：把传递依赖也提升到 node_modules/.pnpm/node_modules，
; 便于 vue-tsc / vite 等工具在隔离链接器下解析到同一份实例。
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

; POC: esbuild/vue-demi 的 postinstall 在 pnpm 11 非 workspace 下被默认拦截，
; 但其平台包已自带二进制，构建无需该脚本。跳过构建脚本以避免 pnpm run 前的依赖校验报错。
ignore-build-scripts=true

; 关键：部分 Windows 环境（无管理员/未开开发者模式）禁止创建符号链接，
; pnpm 默认用 symlink 链接依赖，会静默失败 —— 表现为 node_modules 下
; 依赖目录全空、运行时报 "Cannot find module 'xxx'"，且 `pnpm install` 仍显示成功。
; 改用 hoisted 链接器：扁平化写入 node_modules（无符号链接），可在本机正常构建。
; 生效配置在 pnpm-workspace.yaml 的 nodeLinker（pnpm 11 以工作区文件为准），
; 这里保留同名项仅为兼容旧版本 pnpm。
; 注意：hoisted 会放宽依赖隔离（与 npm 布局类似），生产/CI 若具备 symlink 权限请改回 isolated。
node-linker=hoisted
